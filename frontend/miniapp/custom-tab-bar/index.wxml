<view class="tab-bar">
  <view
    class="tab-item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image
      class="tab-icon"
      mode="aspectFit"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
    />
    <text class="tab-text" style="color: {{selected === index ? selectedColor : color}}">{{item.text}}</text>
  </view>
</view>
