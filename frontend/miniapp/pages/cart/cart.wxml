<view class="page">
  <view class="cart-item" wx:for="{{items}}" wx:key="id">
    <view class="cart-pic">
      <image wx:if="{{item.goods.cover}}" src="{{imgBase}}{{item.goods.cover}}" mode="aspectFill" class="pic-img" />
      <text wx:else>🛍️</text>
    </view>
    <view class="cart-main">
      <view class="cart-name">{{item.goods.name}}</view>
      <view class="cart-spec">{{item.cart.spec}}</view>
      <view class="cart-foot">
        <text class="price">¥ {{item.goods.price}}</text>
        <view class="qty">
          <text class="qty-btn" bindtap="minus" data-item="{{item.cart}}">-</text>
          <text class="qty-num">{{item.cart.quantity}}</text>
          <text class="qty-btn" bindtap="plus" data-item="{{item.cart}}">+</text>
        </view>
      </view>
    </view>
    <text class="del" catchtap="del" data-id="{{item.cart.id}}">删除</text>
  </view>
  <view wx:if="{{items.length===0}}" class="empty">购物车还是空的</view>

  <view wx:if="{{items.length>0}}">
    <!-- 收货地址选择 -->
    <view class="addr-card" bindtap="chooseAddress">
      <block wx:if="{{selectedAddress}}">
        <view class="addr-info">
          <text class="addr-receiver">{{selectedAddress.receiver}} {{selectedAddress.phone}}</text>
          <view class="addr-text">{{selectedAddress.address}}</view>
        </view>
      </block>
      <block wx:else>
        <view class="addr-empty">请选择收货地址</view>
      </block>
      <text class="addr-arrow">›</text>
    </view>

    <view class="settle-bar">
      <text class="total">合计：<text class="price">¥ {{total}}</text></text>
      <view class="settle-btn" bindtap="settle">结算</view>
    </view>
  </view>
</view>
