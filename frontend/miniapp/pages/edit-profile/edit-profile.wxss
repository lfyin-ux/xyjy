.page {
  padding: 32rpx;
}

.avatar-row {
  text-align: center;
  margin-bottom: 30rpx;
}

.avatar-box {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border-radius: 54rpx;
  background: linear-gradient(145deg, #ffd5d2, #9c88e9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-tip {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.radio {
  margin-right: 40rpx;
  font-size: 28rpx;
}
