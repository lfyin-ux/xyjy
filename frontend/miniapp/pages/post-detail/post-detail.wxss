.page {
  padding: 32rpx;
  padding-bottom: 140rpx;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.mini {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #ffe5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  overflow: hidden;
}

.mini-img {
  width: 100%;
  height: 100%;
}

.post-name {
  font-weight: 700;
  font-size: 30rpx;
}

.post-sub {
  color: var(--muted);
  font-size: 24rpx;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.7;
}

.detail-img {
  width: 100%;
  border-radius: 32rpx;
  margin-top: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.comment {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 28rpx;
}

.comment-name {
  color: var(--purple);
  font-weight: 600;
}

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  align-items: center;
}

.comment-bar input {
  flex: 1;
  background: #f3f2f8;
  border-radius: 30rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
}

.send-btn {
  background: var(--purple);
  color: #fff;
  border-radius: 28rpx;
  font-size: 28rpx;
  padding: 0 36rpx;
  line-height: 76rpx;
  margin: 0;
}

.post {
  background: #fff;
  border-radius: 40rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.post-meta {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-top: 16rpx;
}

.status-tag {
  background: #eeeaff;
  color: var(--purple);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
}

.post-time {
  color: var(--muted);
  font-size: 24rpx;
}

.del-btn {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  color: var(--pink);
  font-size: 26rpx;
}
