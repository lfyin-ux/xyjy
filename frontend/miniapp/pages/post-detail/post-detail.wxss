.page {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.mini {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #ffe5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  overflow: hidden;
}

.mini-img {
  width: 100%;
  height: 100%;
}

.post-name {
  font-weight: 700;
  font-size: 30rpx;
}

.post-sub {
  color: var(--muted);
  font-size: 24rpx;
}

.post-text {
  font-size: 30rpx;
  line-height: 1.7;
}

.detail-img {
  width: 100%;
  border-radius: 32rpx;
  margin-top: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.comment {
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
  font-size: 28rpx;
}

.comment-mine {
  opacity: 1;
}

.comment-private {
  background: #f8f6ff;
  margin: 0 -16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  border-bottom: none;
  margin-bottom: 12rpx;
}

.private-hint-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.private-hint {
  font-size: 22rpx;
  color: var(--purple);
  background: #eeeaff;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.comment-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.comment-del-btn {
  margin-left: auto;
  color: var(--pink);
  font-size: 24rpx;
  padding: 4rpx 8rpx;
}

.comment-name {
  color: var(--purple);
  font-weight: 600;
}

.vis-tag {
  font-size: 20rpx;
  color: #999;
  background: #f3f2f8;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.comment-body {
  line-height: 1.6;
}

.reply-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.reply-to-me {
  color: #fff;
  background: var(--purple);
}

.my-reply {
  color: var(--purple);
  background: #eeeaff;
}

.reply-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.reply-at {
  color: var(--muted);
  font-size: 24rpx;
}

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx 20rpx;
  background: #fff;
  border-top: 2rpx solid var(--line);
}

.comment-bar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 24rpx;
}

.reply-hint {
  color: var(--purple);
}

.cancel-reply {
  color: var(--muted);
}

.comment-bar-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.comment-bar input {
  flex: 1;
  background: #f3f2f8;
  border-radius: 30rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  min-width: 0;
}

.vis-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--purple);
  background: #eeeaff;
  padding: 0 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 30rpx;
  white-space: nowrap;
}

.send-btn {
  background: var(--purple);
  color: #fff;
  border-radius: 28rpx;
  font-size: 28rpx;
  padding: 0 36rpx;
  line-height: 76rpx;
  margin: 0;
}

.post {
  background: #fff;
  border-radius: 40rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.post-meta {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-top: 16rpx;
}

.status-tag {
  background: #eeeaff;
  color: var(--purple);
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 18rpx;
}

.post-time {
  color: var(--muted);
  font-size: 24rpx;
}

.del-btn {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  color: var(--pink);
  font-size: 26rpx;
}

/* 我的动态卡片 */
.my-post {
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.my-post-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.my-post-content {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-all;
}

.my-del-btn {
  flex-shrink: 0;
  color: var(--pink);
  font-size: 26rpx;
  padding-top: 4rpx;
}

.my-post-img {
  width: 100%;
  height: 280rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.my-post-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.my-post-stats {
  flex: 1;
  display: flex;
  gap: 24rpx;
}

.stat-item {
  font-size: 26rpx;
  color: #777487;
}

.my-post-topic {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--purple);
}

/* 点赞用户列表 */
.like-users {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.like-user {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.like-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  overflow: hidden;
}

.like-avatar-img {
  width: 100%;
  height: 100%;
}

.like-name {
  font-size: 20rpx;
  color: var(--muted);
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
