<wxs src="../../utils/display.wxs" module="dsp" />
<wxs module="fmt">
function statusText(s) {
  var map = { '0': '草稿', '1': '审核中', '3': '已发布', '4': '审核驳回', '5': '违规拦截', '6': '已删除' }
  return map['' + s] || ''
}
function visLabel(v) {
  var map = { '1': '发布人可见', '2': '回复人可见', '3': '全部可见' }
  return map['' + v] || '全部可见'
}
module.exports = { statusText: statusText, visLabel: visLabel }
</wxs>

<view class="page">
  <!-- 我的动态列表 -->
  <block wx:if="{{mode==='my'}}">
    <view class="my-post" wx:for="{{myPosts}}" wx:key="id" bindtap="viewPost" data-id="{{item.id}}">
      <view class="my-post-head">
        <view class="my-post-content">{{item.content}}</view>
        <text class="my-del-btn" catchtap="delPost" data-id="{{item.id}}">删除</text>
      </view>
      <image wx:if="{{item.images}}" src="{{imgBase}}{{item.firstImg}}" mode="aspectFill" class="my-post-img" />
      <view class="my-post-footer">
        <text class="status-tag" wx:if="{{fmt.statusText(item.status)}}">{{fmt.statusText(item.status)}}</text>
        <view class="my-post-stats">
          <text class="stat-item">♥ {{item.likeCount}}</text>
          <text class="stat-item">💬 {{item.commentCount}}</text>
        </view>
      </view>
      <view wx:if="{{item.topic}}" class="my-post-topic">#{{item.topic}}</view>
    </view>
    <view wx:if="{{myPosts.length===0}}" class="empty">你还没有发布动态</view>
  </block>

  <!-- 动态详情 -->
  <block wx:else>
    <view class="card">
      <view class="post-head">
        <view class="mini">
          <image wx:if="{{post.user.avatar}}" src="{{imgBase}}{{post.user.avatar}}" mode="aspectFill" class="mini-img" />
          <text wx:else>🧑</text>
        </view>
        <view>
          <view class="post-name">{{post.user.nickname}}</view>
          <view class="post-sub">{{post.subText || dsp.postSub(post.user.school, post.post.place)}}</view>
        </view>
      </view>
      <view class="post-text">{{post.post.content}}</view>
      <image wx:if="{{post.firstImg}}" src="{{imgBase}}{{post.firstImg}}" mode="widthFix" class="detail-img" />
    </view>

    <view class="card" wx:if="{{likeUsers.length>0}}">
      <view class="card-title">♥ 点赞 {{likeUsers.length}}</view>
      <view class="like-users">
        <view class="like-user" wx:for="{{likeUsers}}" wx:key="id" bindtap="viewLikeUser" data-id="{{item.user.id}}">
          <view class="like-avatar">
            <image wx:if="{{item.user.avatar}}" src="{{imgBase}}{{item.user.avatar}}" mode="aspectFill" class="like-avatar-img" />
            <text wx:else>🧑</text>
          </view>
          <text class="like-name">{{item.user.nickname}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">评论 {{comments.length}}</view>
      <view class="comment {{item.isMine?'comment-mine':''}} {{item.isPrivate?'comment-private':''}}" wx:for="{{comments}}" wx:key="id"
            bindtap="{{item.isMine?'':'replyComment'}}"
            data-userid="{{item.user.id}}" data-nickname="{{item.user.nickname}}" data-commentid="{{item.comment.id}}">
        <view wx:if="{{item.privateHint}}" class="private-hint-row">
          <text class="private-hint">🔒 {{item.privateHint}}</text>
          <text wx:if="{{item.isMine}}" class="comment-del-btn" catchtap="delComment" data-id="{{item.comment.id}}">删除</text>
        </view>
        <view class="comment-head" wx:if="{{!item.myReply}}">
          <text class="comment-name">{{item.user.nickname}}</text>
          <text wx:if="{{item.repliedToMe}}" class="reply-badge reply-to-me">回复了你</text>
          <text wx:if="{{item.isMine}}" class="comment-del-btn" catchtap="delComment" data-id="{{item.comment.id}}">删除</text>
        </view>
        <view class="comment-body">
          <view wx:if="{{item.replyToUser}}" class="reply-line">
            <text class="reply-at">{{item.isMine ? '我回复了' : '回复'}} @{{item.replyToUser.nickname}}</text>
            <text wx:if="{{item.myReply && !item.privateHint}}" class="comment-del-btn" catchtap="delComment" data-id="{{item.comment.id}}">删除</text>
          </view>
          <text class="comment-text">{{item.comment.content}}</text>
        </view>
      </view>
      <view wx:if="{{comments.length===0}}" class="empty">还没有评论，来说点什么吧</view>
    </view>

    <view wx:if="{{viewOnly}}" class="view-only-tip">当前学校为浏览模式，暂不可评论</view>
    <view class="comment-bar" wx:if="{{!viewOnly}}">
      <view class="comment-bar-top" wx:if="{{replyToNickname}}">
        <text class="reply-hint">回复 @{{replyToNickname}}</text>
        <text class="cancel-reply" bindtap="cancelReply">取消</text>
      </view>
      <view class="comment-bar-row">
        <input placeholder="{{replyToNickname ? '回复 ' + replyToNickname + '…' : '写下你的评论…'}}" value="{{commentText}}" bindinput="onComment" />
        <view class="vis-btn" bindtap="pickVisibility">{{visibilityLabel}}</view>
        <button class="send-btn" bindtap="submitComment">发布</button>
      </view>
    </view>
  </block>
</view>
