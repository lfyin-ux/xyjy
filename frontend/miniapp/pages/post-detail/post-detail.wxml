<wxs module="fmt">
function statusText(s) {
  var map = { '0': '草稿', '1': '审核中', '3': '已发布', '4': '审核驳回', '5': '违规拦截', '6': '已删除' }
  return map[s] || ''
}
module.exports = { statusText: statusText }
</wxs>

<view class="page">
  <!-- 我的动态列表 -->
  <block wx:if="{{mode==='my'}}">
    <view class="post" wx:for="{{myPosts}}" wx:key="id">
      <view class="post-text">{{item.content}}</view>
      <view class="post-meta">
        <text class="status-tag">{{fmt.statusText(item.status)}}</text>
        <text class="post-time">👍 {{item.likeCount}} · 💬 {{item.commentCount}}</text>
      </view>
      <text class="del-btn" catchtap="delPost" data-id="{{item.id}}">删除</text>
    </view>
    <view wx:if="{{myPosts.length===0}}" class="empty">你还没有发布动态</view>
  </block>

  <!-- 动态详情 -->
  <block wx:else>
    <view class="card">
      <view class="post-head">
        <view class="mini">
          <image wx:if="{{post.user.avatar}}" src="{{imgBase}}{{post.user.avatar}}" mode="aspectFill" class="mini-img" />
          <text wx:else>🧑</text>
        </view>
        <view>
          <view class="post-name">{{post.user.nickname}}</view>
          <view class="post-sub">{{post.user.school}} · {{post.post.place}}</view>
        </view>
      </view>
      <view class="post-text">{{post.post.content}}</view>
      <image wx:if="{{post.firstImg}}" src="{{imgBase}}{{post.firstImg}}" mode="widthFix" class="detail-img" />
    </view>

    <view class="card">
      <view class="card-title">评论 {{comments.length}}</view>
      <view class="comment" wx:for="{{comments}}" wx:key="id">
        <text class="comment-name">{{item.user.nickname}}：</text>
        <text class="comment-text">{{item.comment.content}}</text>
      </view>
      <view wx:if="{{comments.length===0}}" class="empty">还没有评论，来说点什么吧</view>
    </view>

    <view class="comment-bar">
      <input placeholder="写下你的评论…" value="{{commentText}}" bindinput="onComment" />
      <button class="send-btn" bindtap="submitComment">发布</button>
    </view>
  </block>
</view>
