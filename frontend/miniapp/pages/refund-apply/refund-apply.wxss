.page {
  padding: 32rpx;
}

.tip {
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 24rpx;
}

.item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: #fff;
  border-radius: 32rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item-check {
  padding-top: 8rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
}

.checkbox.on {
  background: var(--purple);
  border-color: var(--purple);
}

.item-main {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
}

.item-spec {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.item-qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #f3f2f8;
  text-align: center;
  line-height: 46rpx;
  font-size: 34rpx;
}

.qty-num {
  min-width: 40rpx;
  text-align: center;
  font-weight: 700;
}

.qty-max {
  color: var(--muted);
  font-size: 22rpx;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 30rpx;
  margin: 24rpx 0;
}
