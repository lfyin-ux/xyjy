.legal-page {
  padding: 32rpx;
  padding-bottom: 60rpx;
}

.legal-title {
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.legal-meta {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 32rpx;
}

.legal-section {
  margin-bottom: 28rpx;
}

.legal-h {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.legal-p {
  font-size: 26rpx;
  line-height: 1.8;
  color: #444;
  margin-bottom: 10rpx;
}

.legal-li {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #444;
  padding-left: 20rpx;
  margin-bottom: 8rpx;
}
