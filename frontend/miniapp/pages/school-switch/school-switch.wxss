.page {
  padding: 24rpx 32rpx 48rpx;
}

.tip-card {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(34, 27, 78, 0.04);
}

.tip-icon {
  font-size: 32rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.tip-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

.hero-card {
  padding: 36rpx 36rpx 32rpx;
  margin-bottom: 36rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #2b2548 0%, #5b4bb5 100%);
  color: #fff;
  box-shadow: 0 20rpx 50rpx rgba(43, 37, 72, 0.22);
}

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hero-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.status-badge {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-badge.home {
  background: rgba(216, 255, 123, 0.18);
  color: #d8ff7b;
}

.status-badge.view {
  background: rgba(255, 213, 140, 0.2);
  color: #ffd58c;
}

.status-badge.unlock {
  background: rgba(167, 243, 208, 0.2);
  color: #a7f3d0;
}

.hero-school {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: -1rpx;
  margin-bottom: 24rpx;
}

.progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-bottom: 12rpx;
}

.progress-num {
  font-weight: 700;
  color: #ffd58c;
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd58c, #ff9f6b);
  min-width: 8rpx;
  transition: width 0.3s ease;
}

.hero-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.72);
}

.hero-desc.ok {
  color: #a7f3d0;
}

.back-home {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 18rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
}

.back-home:active {
  background: rgba(255, 255, 255, 0.2);
}

.back-icon {
  font-size: 28rpx;
  line-height: 1;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--ink);
}

.section-sub {
  font-size: 24rpx;
  color: var(--muted);
}

.list-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 24rpx;
  box-shadow: 0 14rpx 44rpx rgba(34, 27, 78, 0.05);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
  border-radius: 28rpx;
  background: #fafafd;
  border: 2rpx solid var(--line);
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.55;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

.school-list {
  max-height: 680rpx;
}

.school-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 20rpx;
  border-radius: 24rpx;
  margin-bottom: 8rpx;
}

.school-item:last-child {
  margin-bottom: 0;
}

.school-item:active {
  background: #f7f6fb;
}

.school-item.picked {
  background: #f3f1ff;
}

.school-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.school-name {
  font-size: 30rpx;
  color: var(--ink);
}

.school-item.picked .school-name {
  color: var(--purple);
  font-weight: 800;
}

.home-tag {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #166534;
  font-size: 20rpx;
  font-weight: 700;
}

.picked-mark {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--purple);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.list-empty {
  text-align: center;
  color: var(--muted);
  padding: 60rpx 0 40rpx;
  font-size: 26rpx;
}
