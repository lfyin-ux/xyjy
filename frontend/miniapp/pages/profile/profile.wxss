.page {
  padding: 32rpx;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.big-profile {
  text-align: center;
  padding: 50rpx;
  background: linear-gradient(145deg, #2d274d, #6c5ce7);
  color: #fff;
  border-radius: 54rpx;
  margin-bottom: 28rpx;
}

.face {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border-radius: 60rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  background: rgba(255, 255, 255, 0.12);
}

.face-img {
  width: 100%;
  height: 100%;
}

.big-name {
  font-size: 44rpx;
  font-weight: 800;
  margin: 20rpx 0 10rpx;
}

.big-school {
  font-size: 26rpx;
  color: #d8d3ee;
  margin-bottom: 20rpx;
}

.chips-center {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
}

.chips-center .chip {
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.intro {
  font-size: 28rpx;
  line-height: 1.7;
  color: #555;
}

.profile-actions {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.follow-btn {
  width: 100%;
  border: 0;
  border-radius: 34rpx;
  padding: 28rpx;
  background: var(--purple);
  color: #fff;
  font-weight: 800;
  font-size: 30rpx;
}

.follow-btn.followed {
  background: #fff;
  color: var(--purple);
  border: 2rpx solid var(--purple);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-name {
  font-size: 30rpx;
  font-weight: 700;
}

.user-sub {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 主页相册 */
.profile-album {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.profile-photo {
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
}

/* 全屏预览 */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.preview-img {
  width: 100%;
  height: 80vh;
}
