<view class="page">
  <view wx:if="{{previewUrl}}" class="preview-mask" bindtap="closePreview">
    <image src="{{previewUrl}}" mode="aspectFit" class="preview-img" />
  </view>

  <view class="big-profile">
    <view class="face">
      <image wx:if="{{user.avatar}}" src="{{imgBase}}{{user.avatar}}" mode="aspectFill" class="face-img" />
      <text wx:else>🧑‍🎓</text>
    </view>
    <view class="big-name">{{displayName || user.nickname}}</view>
    <view class="big-school">{{user.school}} · 已实名 ✓</view>
    <view class="chips-center">
      <text class="chip" wx:for="{{tagList}}" wx:key="*this">{{item}}</text>
    </view>
  </view>
  <view class="card">
    <view class="card-title">关于 TA</view>
    <view class="intro">{{user.intro || '这位同学还没有填写简介'}}</view>
  </view>

  <view class="card" wx:if="{{album.length>0}}">
    <view class="card-title">相册</view>
    <view class="profile-album">
      <image wx:for="{{album}}" wx:key="id" src="{{imgBase}}{{item.imgUrl}}" mode="aspectFill" class="profile-photo" data-url="{{imgBase}}{{item.imgUrl}}" bindtap="previewPhoto" />
    </view>
  </view>
</view>
