.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat-box {
  flex: 1;
  padding: 24rpx 28rpx 10rpx;
  overflow-y: auto;
  box-sizing: border-box;
  width: 100%;
}

.chat-note {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  margin: 20rpx auto;
  background: #f3f1ff;
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.msg-row.me {
  justify-content: flex-end;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.bubble {
  max-width: 60%;
  padding: 22rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  font-size: 28rpx;
  word-break: break-all;
  line-height: 1.5;
  box-sizing: border-box;
}

.msg-row.me .bubble {
  background: var(--purple);
  color: #fff;
}

.chat-input {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  align-items: center;
  border-top: 2rpx solid var(--line);
}

.chat-input input {
  flex: 1;
  background: #f3f2f8;
  border-radius: 30rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.input-btn {
  font-size: 44rpx;
  width: 60rpx;
  text-align: center;
  flex-shrink: 0;
}

.send-btn {
  background: var(--purple);
  color: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
  line-height: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

/* emoji面板 */
.emoji-panel {
  background: #fff;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid var(--line);
  display: flex;
  flex-wrap: wrap;
  max-height: 300rpx;
  overflow-y: auto;
}

.emoji-item {
  width: 60rpx;
  height: 60rpx;
  font-size: 44rpx;
  text-align: center;
  line-height: 60rpx;
}

/* 图片消息气泡 */
.bubble-img {
  max-width: 55%;
  border-radius: 24rpx;
  min-width: 160rpx;
}

.loading-more {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  padding: 20rpx 0;
}
