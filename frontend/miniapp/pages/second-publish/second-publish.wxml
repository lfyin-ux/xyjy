<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">商品名称</text>
      <input placeholder="请输入商品名称" value="{{name}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="label">分类</text>
      <input placeholder="如 数码 / 书籍 / 生活" value="{{category}}" bindinput="onCategory" />
    </view>
    <view class="field">
      <text class="label">成色</text>
      <input placeholder="如 九成新 / 全新" value="{{conditionDesc}}" bindinput="onCondition" />
    </view>
    <view class="field">
      <text class="label">价格（元）</text>
      <input type="digit" placeholder="请输入价格" value="{{price}}" bindinput="onPrice" />
    </view>
    <view class="field">
      <text class="label">商品描述</text>
      <textarea placeholder="描述商品状况" value="{{description}}" bindinput="onDesc" />
    </view>
    <view class="field">
      <text class="label">商品图片</text>
      <view class="img-grid">
        <view class="img-item" wx:for="{{images}}" wx:key="*this">
          <image src="{{imgBase}}{{item}}" mode="aspectFill" class="grid-img" />
          <text class="img-del" catchtap="delImg" data-idx="{{index}}">×</text>
        </view>
        <view wx:if="{{images.length<6}}" class="img-add" bindtap="addImg">＋</view>
      </view>
    </view>
    <button class="primary" bindtap="publish">发布商品</button>
  </view>
</view>
