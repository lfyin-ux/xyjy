.page {
  padding: 24rpx;
}

.tab-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab {
  display: inline-block;
  padding: 16rpx 30rpx;
  margin-right: 14rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #615e70;
}

.tab.on {
  background: var(--purple);
  color: #fff;
}

.order {
  background: #fff;
  border-radius: 40rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.order-no {
  color: var(--muted);
  font-size: 24rpx;
}

.order-status {
  color: var(--purple);
  font-weight: 700;
  font-size: 26rpx;
}

.order-goods {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 20rpx 0;
}

.g-pic {
  width: 110rpx;
  height: 110rpx;
  border-radius: 24rpx;
  background: #ede9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  overflow: hidden;
}

.g-img {
  width: 100%;
  height: 100%;
}

.g-main {
  flex: 1;
}

.g-name {
  font-size: 28rpx;
  font-weight: 600;
}

.g-spec {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--line);
}

.order-total {
  font-size: 28rpx;
}

.order-btns {
  display: flex;
  gap: 12rpx;
}

.o-btn {
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: #fff;
  color: #615e70;
  font-size: 24rpx;
  padding: 0 26rpx;
  line-height: 60rpx;
  margin: 0;
}

.primary-btn {
  background: var(--purple);
  color: #fff;
  border-color: var(--purple);
}
