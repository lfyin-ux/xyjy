<wxs module="fmt">
function statusText(s) {
  var map = { '1': '招募中', '2': '已满员', '3': '已结束' }
  return map['' + s] || ''
}
module.exports = { statusText: statusText }
</wxs>

<view class="page">
  <view class="dual">
    <view class="mode-btn {{tab==='all'?'active':''}}" bindtap="switchTab" data-t="all">全部组局</view>
    <view class="mode-btn {{tab==='created'?'active':''}}" bindtap="switchTab" data-t="created">我发起的</view>
    <view class="mode-btn {{tab==='joined'?'active':''}}" bindtap="switchTab" data-t="joined">我加入的</view>
  </view>

  <view class="team" wx:for="{{currentList}}" wx:key="id" bindtap="viewDetail" data-id="{{item.id}}">
    <view class="team-head">
      <text class="team-name">🎮 {{item.gameName}}</text>
      <text class="status-tag" wx:if="{{fmt.statusText(item.status)}}">{{fmt.statusText(item.status)}}</text>
    </view>
    <view class="team-info">时间：{{item.playTime}}</view>
    <view class="team-info">要求：{{item.requireDesc}}</view>
    <view class="team-foot">
      <text class="team-num">{{item.joinedNum}} / {{item.needNum}} 人</text>
      <view wx:if="{{item.status===1 && tab==='all'}}" class="join-btn" catchtap="join" data-id="{{item.id}}">申请加入</view>
      <view wx:if="{{tab==='joined' && item.status!==3}}" class="quit-btn" catchtap="quit" data-id="{{item.id}}">退出组局</view>
    </view>
  </view>
  <view wx:if="{{currentList.length===0}}" class="empty">暂无组局</view>

  <view class="fab" bindtap="openCreate">＋</view>

  <!-- 组局详情弹窗 显示成员 -->
  <view wx:if="{{showDetail}}" class="mask" bindtap="closeDetail">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">组局成员</view>
      <view class="member-row" wx:for="{{members}}" wx:key="id">
        <view class="member-left" bindtap="viewProfile" data-id="{{item.user.id}}">
          <view class="member-avatar">
            <image wx:if="{{item.user.avatar}}" src="{{imgBase}}{{item.user.avatar}}" mode="aspectFill" class="member-img" />
            <text wx:else>🧑</text>
          </view>
          <view class="member-info">
            <text class="member-name">{{item.user.nickname}}</text>
            <text class="member-school">{{item.user.school}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{members.length===0}}" class="empty">暂无成员</view>
    </view>
  </view>

  <!-- 发起组局弹窗 -->
  <view wx:if="{{showCreate}}" class="mask" bindtap="closeCreate">
    <view class="dialog" catchtap="noop">
      <view class="dialog-title">发起新组局</view>
      <view class="field">
        <text class="label">游戏名称</text>
        <input placeholder="如 王者荣耀" value="{{gameName}}" bindinput="onName" />
      </view>
      <view class="field">
        <text class="label">时间</text>
        <input placeholder="如 今晚 20:00" value="{{playTime}}" bindinput="onTime" />
      </view>
      <view class="field">
        <text class="label">需要人数</text>
        <input type="number" placeholder="如 5" value="{{needNum}}" bindinput="onNum" />
      </view>
      <view class="field">
        <text class="label">参与要求</text>
        <input placeholder="如 有麦，钻石以上" value="{{requireDesc}}" bindinput="onReq" />
      </view>
      <button class="primary" bindtap="create">确认发起</button>
    </view>
  </view>
</view>
