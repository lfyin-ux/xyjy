.page {
  padding: 32rpx;
}

.team {
  background: #fff;
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.team-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.team-name {
  font-size: 32rpx;
  font-weight: 700;
}

.status-tag {
  background: #f0f0f5;
  color: var(--muted);
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.status-tag.on {
  background: #edebff;
  color: var(--purple);
}

.team-info {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 12rpx;
}

.team-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.team-num {
  color: var(--purple);
  font-weight: 700;
  font-size: 28rpx;
}

.join-btn {
  border: 0;
  border-radius: 24rpx;
  padding: 0 30rpx;
  background: var(--purple);
  color: #fff;
  font-size: 26rpx;
  line-height: 68rpx;
  margin: 0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 40rpx;
  background: var(--purple);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(108, 92, 231, 0.4);
  padding: 0;
  line-height: 1;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.dialog {
  width: 620rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
  text-align: center;
}

.dual {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  border-radius: 36rpx;
  padding: 24rpx 8rpx;
  background: #fff;
  color: var(--muted);
  font-weight: 800;
  font-size: 26rpx;
}

.mode-btn.active {
  background: var(--purple);
  color: #fff;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.member-row:last-child {
  border-bottom: 0;
}

.member-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-school {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.member-contact {
  font-size: 22rpx;
  color: #555;
  margin-top: 6rpx;
}

.copy-btn {
  flex-shrink: 0;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 18rpx;
  background: #f3f1ff;
  color: var(--purple);
  font-size: 22rpx;
  font-weight: 700;
}

.member-msg {
  border: 2rpx solid var(--purple);
  color: var(--purple);
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  overflow: hidden;
}

.member-img {
  width: 100%;
  height: 100%;
}

.member-name {
  font-size: 28rpx;
}

.quit-btn {
  border: 2rpx solid var(--pink);
  border-radius: 24rpx;
  padding: 0 24rpx;
  color: var(--pink);
  font-size: 26rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
}
