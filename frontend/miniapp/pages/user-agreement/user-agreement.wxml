<scroll-view class="legal-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="legal-page">
    <view class="legal-title">{{doc.title}}</view>
    <view class="legal-meta">更新日期：{{doc.metaUpdate}} · 生效日期：{{doc.metaEffect}}</view>

    <block wx:for="{{doc.blocks}}" wx:key="index">
      <view wx:if="{{item.type === 'h'}}" class="legal-section">
        <view class="legal-h">{{item.text}}</view>
      </view>
      <view wx:elif="{{item.type === 'li'}}" class="legal-section legal-li-wrap">
        <text class="legal-li">{{item.text}}</text>
      </view>
      <view wx:else class="legal-section">
        <text class="legal-p">{{item.text}}</text>
      </view>
    </block>
  </view>
</scroll-view>
