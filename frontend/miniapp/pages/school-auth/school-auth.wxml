<view class="page">
  <view class="notice">学校认证决定你所属的校园社区。审核通过后，只能查看和联系本校用户。</view>

  <view class="agree-row" bindtap="toggleAgree">
    <view class="agree-check {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
    <view class="agree-text">
      我已阅读
      <text class="agree-link" catchtap="openPrivacy">《隐私政策》</text>
      ，同意平台收集并使用我的学校、院系、学号及证明材料，用于学校认证审核。
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">学校名称</text>
      <view class="mode-tabs">
        <view class="mode-tab {{schoolMode==='select'?'on':''}}" bindtap="switchToSelect">从列表选择</view>
        <view class="mode-tab {{schoolMode==='manual'?'on':''}}" bindtap="switchToManual">手动输入</view>
      </view>
    </view>

    <block wx:if="{{schoolMode==='select'}}">
      <view class="field">
        <input placeholder="搜索学校名称" value="{{schoolKeyword}}" bindinput="onSchoolKeyword" />
      </view>
      <view class="school-picked" wx:if="{{schoolId}}">已选：{{schoolName}}</view>
      <scroll-view scroll-y class="school-list" wx:if="{{schoolOptions.length}}">
        <view class="school-item {{schoolId===item.id?'picked':''}}"
          wx:for="{{schoolOptions}}" wx:key="id"
          data-item="{{item}}" bindtap="pickSchool">
          {{item.schoolName}}
        </view>
      </scroll-view>
      <view class="school-empty" wx:elif="{{schoolKeyword}}">未找到匹配学校，可切换到「手动输入」</view>
    </block>

    <block wx:else>
      <view class="field">
        <input placeholder="请输入学校全称" value="{{schoolName}}" bindinput="onSchoolManual" />
      </view>
      <view class="school-tip">手填学校需后台审核确认后才会加入学校字典</view>
    </block>

    <view class="field">
      <text class="label">证明材料类型</text>
      <picker range="{{docTypes}}" bindchange="onDocType">
        <view class="picker-val">{{docType}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="label">院系</text>
      <input placeholder="请输入院系" value="{{college}}" bindinput="onCollege" />
    </view>
    <view class="field">
      <text class="label">学号</text>
      <input placeholder="请输入学号" value="{{studentNo}}" bindinput="onStudentNo" />
    </view>

    <view class="upload {{docImg?'has':''}}" bindtap="uploadDoc">
      <block wx:if="{{docImg}}">
        <image src="{{imgBase}}{{docImg}}" mode="aspectFill" class="upload-img" />
      </block>
      <block wx:else>
        <view class="upload-icon">📄</view>
        <text>上传学校证明材料照片</text>
      </block>
    </view>

    <view class="field">
      <text class="label">补充说明（选填）</text>
      <textarea placeholder="可填写年级等辅助审核信息" value="{{remark}}" bindinput="onRemark" />
    </view>

    <button class="primary" bindtap="submit" disabled="{{!agreed}}">提交学校认证审核</button>
  </view>
</view>
