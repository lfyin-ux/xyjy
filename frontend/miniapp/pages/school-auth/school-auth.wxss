.page {
  padding: 32rpx;
}

.notice {
  padding: 24rpx 28rpx;
  border-radius: 30rpx;
  background: #f3f1ff;
  color: #625a91;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
}

.agree-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-top: 4rpx;
}

.agree-check.on {
  background: var(--purple);
  border-color: var(--purple);
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #555;
}

.agree-link {
  color: var(--purple);
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 24rpx;
  background: #f3f1ff;
  color: #625a91;
  font-size: 26rpx;
}

.mode-tab.on {
  background: var(--purple);
  color: #fff;
}

.school-picked {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: #f0fdf4;
  color: #166534;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.school-list {
  max-height: 320rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  background: #fafafd;
}

.school-item {
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid #eee;
}

.school-item.picked {
  background: #f3f1ff;
  color: var(--purple);
  font-weight: 600;
}

.school-empty,
.school-tip {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.picker-val {
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx;
  background: #fafafd;
  font-size: 28rpx;
}

.upload {
  border: 3rpx dashed #c9c5dd;
  border-radius: 34rpx;
  padding: 40rpx;
  text-align: center;
  background: #fafafd;
  color: #6d687d;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.upload.has {
  border-style: solid;
  border-color: var(--purple);
  padding: 0;
  overflow: hidden;
}

.upload-icon {
  font-size: 62rpx;
  margin-bottom: 10rpx;
}

.upload-img {
  width: 100%;
  height: 320rpx;
}
