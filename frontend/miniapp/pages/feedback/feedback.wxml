<view class="page">
  <view class="card">
    <view class="card-title">你的建议</view>
    <textarea class="fb-textarea" placeholder="欢迎向我们反馈使用中遇到的问题或建议…" value="{{content}}" bindinput="onContent" maxlength="500" />
    <view class="word-count">{{content.length}}/500</view>

    <view class="fb-field">
      <text class="fb-label">联系方式（选填）</text>
      <input class="fb-input" placeholder="手机号或微信，方便我们联系你" value="{{contact}}" bindinput="onContact" />
    </view>

    <button class="primary" bindtap="submit">提交反馈</button>
  </view>

  <view class="tip">我们会认真阅读每一条反馈，感谢你帮助碰个面变得更好 💜</view>
</view>
