.page {
  padding: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.fb-textarea {
  width: 100%;
  height: 240rpx;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 24rpx;
  background: #fafafd;
  font-size: 28rpx;
  line-height: 1.6;
}

.word-count {
  text-align: right;
  color: var(--muted);
  font-size: 22rpx;
  margin-top: 10rpx;
}

.fb-field {
  margin-top: 24rpx;
}

.fb-label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}

.fb-input {
  width: 100%;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #fafafd;
  font-size: 28rpx;
}

.primary {
  margin-top: 36rpx;
}

.tip {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 30rpx;
  line-height: 1.6;
}
