<view class="page">
  <view class="notice">请确保手机号及身份证属于本人。材料仅用于身份审核，审核结果将在认证中心展示。</view>

  <view class="agree-row" bindtap="toggleAgree">
    <view class="agree-check {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
    <view class="agree-text">
      我已阅读
      <text class="agree-link" catchtap="openPrivacy">《隐私政策》</text>
      ，同意平台收集并使用我的手机号码、真实姓名、身份证号码及身份证影像，用于个人实名认证审核。
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">手机号码</text>
      <input type="number" maxlength="11" placeholder="请输入本人手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="label">短信验证码</text>
      <view class="sms-row">
        <input type="number" maxlength="6" placeholder="6位验证码" value="{{code}}" bindinput="onCode" />
        <button class="sms-btn" bindtap="sendCode">获取验证码</button>
      </view>
    </view>
    <view class="field">
      <text class="label">真实姓名</text>
      <input placeholder="请输入身份证姓名" value="{{realName}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="label">身份证号码</text>
      <input maxlength="18" placeholder="请输入18位身份证号码" value="{{idCard}}" bindinput="onIdCard" />
    </view>

    <view class="upload {{idFrontImg?'has':''}}" bindtap="uploadFront">
      <block wx:if="{{idFrontImg}}">
        <image src="{{imgBase}}{{idFrontImg}}" mode="aspectFill" class="upload-img" />
      </block>
      <block wx:else>
        <view class="upload-icon">🪪</view>
        <text>上传身份证人像面</text>
      </block>
    </view>

    <view class="upload {{idBackImg?'has':''}}" bindtap="uploadBack">
      <block wx:if="{{idBackImg}}">
        <image src="{{imgBase}}{{idBackImg}}" mode="aspectFill" class="upload-img" />
      </block>
      <block wx:else>
        <view class="upload-icon">🏛️</view>
        <text>上传身份证国徽面</text>
      </block>
    </view>

    <button class="primary" bindtap="submit" disabled="{{!agreed}}">提交个人认证审核</button>
  </view>
</view>
