<view class="page">
  <view class="notice">请确保手机号及身份证属于本人。材料仅用于身份审核，审核结果将在认证中心展示。</view>

  <view class="agree-row" bindtap="toggleAgree">
    <view class="agree-check {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
    <view class="agree-text">
      我已阅读
      <text class="agree-link" catchtap="openPrivacy">《隐私政策》</text>
      ，同意平台收集并使用我的手机号码、真实姓名、身份证号码及人脸信息，用于个人实名认证与人脸核身审核。
    </view>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">手机号码</text>
      <input type="number" maxlength="11" placeholder="请输入本人手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="label">短信验证码</text>
      <view class="sms-row">
        <input type="number" maxlength="6" placeholder="6位验证码" value="{{code}}" bindinput="onCode" />
        <button class="sms-btn" bindtap="sendCode" disabled="{{smsBtnDisabled}}">{{smsBtnText}}</button>
      </view>
      <view wx:if="{{codeExpireText}}" class="sms-tip">{{codeExpireText}}</view>
    </view>
    <view class="field">
      <text class="label">真实姓名</text>
      <input placeholder="请输入身份证姓名" value="{{realName}}" bindinput="onName" />
    </view>
    <view class="field">
      <text class="label">身份证号码</text>
      <input maxlength="18" placeholder="请输入18位身份证号码" value="{{idCard}}" bindinput="onIdCard" />
    </view>

    <view class="face-card">
      <view class="face-title">人脸核身（拍照）</view>
      <view class="face-tip">请使用前置摄像头拍摄本人正脸照片，系统将比对姓名与身份证信息。每人每天仅可核身 1 次（失败也计入），请确认信息无误后再拍照。正式提交仍需完成手机号验证。</view>
      <image wx:if="{{facePreview}}" class="face-preview" src="{{facePreview}}" mode="aspectFill" />
      <view class="face-status {{faceVerified?'ok':''}}">
        {{faceVerified ? '✓ 人脸核身已完成' : (faceVerifying ? '核身进行中…' : '尚未完成人脸核身')}}
      </view>
      <view wx:if="{{faceError}}" class="face-error">{{faceError}}</view>
      <button class="face-btn" bindtap="startFaceVerify" disabled="{{!agreed || faceVerifying}}">
        {{faceVerified ? '重新拍照核身' : '拍照人脸核身'}}
      </button>
    </view>

    <button class="primary" bindtap="submit" disabled="{{!agreed || !faceVerified}}">完成个人认证</button>
  </view>
</view>
