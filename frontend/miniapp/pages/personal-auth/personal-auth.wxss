.page {
  padding: 32rpx;
}

.notice {
  padding: 24rpx 28rpx;
  border-radius: 30rpx;
  background: #f3f1ff;
  color: #625a91;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
}

.agree-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-top: 4rpx;
}

.agree-check.on {
  background: var(--purple);
  border-color: var(--purple);
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.7;
  color: #555;
}

.agree-link {
  color: var(--purple);
}

.sms-row {
  display: flex;
  gap: 16rpx;
}

.sms-row input {
  flex: 1;
}

.sms-btn {
  border: 0;
  border-radius: 26rpx;
  background: #eeeaff;
  color: var(--purple);
  padding: 0 24rpx;
  font-size: 26rpx;
  line-height: 90rpx;
  margin: 0;
}

.upload {
  border: 3rpx dashed #c9c5dd;
  border-radius: 34rpx;
  padding: 40rpx;
  text-align: center;
  background: #fafafd;
  color: #6d687d;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.upload.has {
  border-style: solid;
  border-color: var(--purple);
  padding: 0;
  overflow: hidden;
}

.upload-icon {
  font-size: 62rpx;
  margin-bottom: 10rpx;
}

.upload-img {
  width: 100%;
  height: 320rpx;
}
