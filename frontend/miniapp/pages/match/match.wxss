.tabs {
  display: flex;
  margin: 0 32rpx 30rpx;
  background: #e9e8ef;
  border-radius: 32rpx;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 24rpx;
  color: #777487;
  font-weight: 700;
  font-size: 28rpx;
}

.tab.active {
  background: #fff;
  color: var(--ink);
  box-shadow: 0 8rpx 24rpx rgba(40, 30, 90, 0.08);
}

.filterbar {
  white-space: nowrap;
  padding: 0 32rpx 20rpx;
}

.filter {
  display: inline-block;
  border: 2rpx solid var(--line);
  background: #fff;
  border-radius: 28rpx;
  padding: 18rpx 24rpx;
  margin-right: 16rpx;
  color: #615e70;
  font-size: 26rpx;
}

.filter.on {
  background: var(--purple);
  color: #fff;
  border-color: var(--purple);
}

.match-card {
  height: 820rpx;
  margin: 0 32rpx;
  border-radius: 60rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(155deg, #f2c7bb, #a688d8 45%, #3b2d61);
  box-shadow: 0 28rpx 80rpx rgba(34, 27, 78, 0.1);
}

.portrait {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 300rpx;
}

.portrait-img {
  width: 100%;
  height: 100%;
}

.match-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 60%;
  background: linear-gradient(0deg, rgba(20, 15, 42, 0.82), transparent);
}

.verified {
  position: absolute;
  top: 36rpx;
  left: 36rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #51419c;
  padding: 14rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 800;
  z-index: 2;
}

.bio {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 40rpx;
  color: #fff;
  z-index: 2;
}

.bio-name {
  font-size: 58rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.bio-school {
  font-size: 28rpx;
  color: #eee9f7;
  margin-bottom: 20rpx;
}

.chip-w {
  display: inline-block;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  font-size: 24rpx;
  margin: 0 12rpx 12rpx 0;
  color: #fff;
}

.actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  margin: 28rpx;
}

.action {
  width: 88rpx;
  height: 88rpx;
  border: 0;
  border-radius: 32rpx;
  background: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(34, 27, 78, 0.1);
  padding: 0;
  line-height: 1;
}

.action.like {
  width: 108rpx;
  height: 108rpx;
  background: var(--purple);
  color: #fff;
  border-radius: 40rpx;
  font-size: 48rpx;
}

.action.star {
  color: #f3a61f;
}

/* 广场 */
.feed {
  padding: 0 32rpx;
}

.post {
  background: #fff;
  border-radius: 46rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 14rpx 44rpx rgba(34, 27, 78, 0.05);
}

.post-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mini {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #ffe5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  overflow: hidden;
}

.mini-img {
  width: 100%;
  height: 100%;
}

.post-name {
  font-weight: 700;
  font-size: 30rpx;
}

.post-sub {
  color: var(--muted);
  font-size: 24rpx;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.65;
  margin: 20rpx 0;
}

.post-img {
  width: 100%;
  height: 340rpx;
  border-radius: 36rpx;
  background: #eee;
}

.post-foot {
  display: flex;
  gap: 40rpx;
  padding-top: 24rpx;
  color: #777487;
  font-size: 26rpx;
}

.post-action.on {
  color: var(--pink);
  font-weight: 800;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--purple);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.4);
  padding: 0;
  line-height: 1;
  overflow: hidden;
}
