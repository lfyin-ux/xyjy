.hero .h2 {
  margin: 14rpx 0 10rpx;
  font-size: 50rpx;
  font-weight: 800;
}

.feed {
  padding: 0 32rpx 120rpx;
}

.post {
  background: #fff;
  border-radius: 46rpx;
  padding: 30rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 14rpx 44rpx rgba(34, 27, 78, 0.05);
}

.post-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.mini {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #ffe5ee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  overflow: hidden;
}

.mini-img {
  width: 100%;
  height: 100%;
}

.post-name {
  font-weight: 700;
  font-size: 30rpx;
}

.post-sub {
  color: var(--muted);
  font-size: 24rpx;
}

.post-text {
  font-size: 28rpx;
  line-height: 1.65;
  margin: 20rpx 0;
}

.post-img {
  width: 100%;
  height: 340rpx;
  border-radius: 36rpx;
  background: #eee;
}

.post-foot {
  display: flex;
  gap: 40rpx;
  padding-top: 24rpx;
  color: #777487;
  font-size: 26rpx;
}

.post-action.on {
  color: var(--pink);
  font-weight: 800;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 60rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--purple);
  color: #fff;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.4);
  padding: 0;
  line-height: 1;
  overflow: hidden;
}

.gate {
  text-align: center;
  padding: 80rpx 40rpx;
}

.gate-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.gate-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.gate-desc {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 40rpx;
}
