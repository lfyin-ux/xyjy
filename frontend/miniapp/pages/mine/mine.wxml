<view class="page">
  <view class="top">
    <view class="brand">我的<i>空间</i></view>
  </view>

  <!-- 认证提示条 未双认证时显示（审核期间暂时隐藏，恢复时将 wx:if 改回 !fullAccess） -->
  <view wx:if="{{false && !fullAccess}}" class="auth-banner" bindtap="goAuth">
    <text class="auth-icon">🛡️</text>
    <view class="auth-banner-main">
      <view class="auth-banner-title">完成认证后解锁全部功能</view>
      <view class="auth-banner-sub">{{authSummary}}</view>
    </view>
    <text class="auth-arrow">›</text>
  </view>

  <!-- 个人卡片 -->
  <view wx:if="{{!loggedIn}}" class="guest-card">
    <view class="guest-icon">👋</view>
    <view class="guest-main">
      <view class="guest-title">欢迎体验同行时空</view>
      <view class="guest-desc">您可先浏览广场、校园生活和商城，需要发布、互动或下单时再登录。</view>
    </view>
    <button class="guest-login" bindtap="goLogin">登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
  <view class="profile-top">
    <view class="profile-user">
      <view class="profile-avatar">
        <image wx:if="{{user.avatar}}" src="{{imgBase}}{{user.avatar}}" mode="aspectFill" class="avatar-img" />
        <text wx:else>🧑‍🎓</text>
      </view>
      <view>
        <view class="profile-name">{{user.nickname}}<text wx:if="{{profileExtra}}" class="profile-gender"> {{profileExtra}}</text></view>
        <view class="profile-auth">{{fullAccess ? user.school + ' · 双认证已通过 ✓' : '账号已注册 · 待完成认证'}}</view>
      </view>
    </view>
  </view>

  <view class="menu">
    <view class="menu-row" bindtap="goAuth">
      <text class="menu-icon">🛡️</text>
      <text class="menu-name">认证中心</text>
      <text class="menu-val">{{fullAccess ? '已认证 ✓' : '待认证'}} ›</text>
    </view>
    <view class="menu-row" bindtap="goEditProfile">
      <text class="menu-icon">🪪</text>
      <text class="menu-name">编辑个人资料</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goAlbum">
      <text class="menu-icon">🖼️</text>
      <text class="menu-name">我的相册</text>
      <text class="menu-val">›</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-row" bindtap="goMyPosts">
      <text class="menu-icon">📝</text>
      <text class="menu-name">我的动态</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goMyComments">
      <text class="menu-icon">💬</text>
      <text class="menu-name">我的评论</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goMyErrand">
      <text class="menu-icon">🏃</text>
      <text class="menu-name">我的跑腿订单</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goMySecond">
      <text class="menu-icon">♻️</text>
      <text class="menu-name">我的二手商品</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goOrders">
      <text class="menu-icon">🛍️</text>
      <text class="menu-name">我的商城订单</text>
      <text class="menu-val">›</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-row" bindtap="goBlacklist">
      <text class="menu-icon">🚫</text>
      <text class="menu-name">黑名单管理</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goAddress">
      <text class="menu-icon">📍</text>
      <text class="menu-name">收货地址管理</text>
      <text class="menu-val">›</text>
    </view>
  </view>
  </block>

  <view class="menu">
    <view class="menu-row" bindtap="goUserAgreement">
      <text class="menu-icon">📄</text>
      <text class="menu-name">用户服务协议</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="goPrivacyPolicy">
      <text class="menu-icon">🔒</text>
      <text class="menu-name">隐私政策</text>
      <text class="menu-val">›</text>
    </view>
    <view class="menu-row" bindtap="feedback">
      <text class="menu-icon">💡</text>
      <text class="menu-name">意见反馈</text>
      <text class="menu-val">›</text>
    </view>
    <view wx:if="{{loggedIn}}" class="menu-row" bindtap="logout">
      <text class="menu-icon">🚪</text>
      <text class="menu-name">退出登录</text>
      <text class="menu-val">›</text>
    </view>
  </view>
</view>
