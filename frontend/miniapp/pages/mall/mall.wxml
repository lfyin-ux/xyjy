<view class="page">
  <view class="top">
    <view class="brand">青春<i>好物</i></view>
    <button class="icon-btn cart-btn" bindtap="goCart">🛒<text wx:if="{{cartCount>0}}" class="cart-badge">{{cartCount}}</text></button>
  </view>

  <block wx:if="{{locked}}">
    <view class="gate">
      <view class="gate-icon">🔐</view>
      <view class="gate-title">功能暂未解锁</view>
      <view class="gate-desc">完成个人认证和学校认证后才能使用商城功能。</view>
      <button class="primary" bindtap="goAuth">前往认证中心</button>
    </view>
  </block>

  <block wx:else>

  <!-- 顶部宣传卡 -->
  <view class="mall-hero">
    <text class="hero-small">本周校园限定</text>
    <view class="hero-title">把热爱<text class="hero-br">带进日常</text></view>
    <button class="hero-btn" bindtap="explore">立即探索 →</button>
    <text class="hero-emoji">🎒</text>
  </view>

  <!-- 我的订单入口 -->
  <view class="order-panel">
    <view class="order-title">
      <text class="ot-name">我的订单</text>
      <text class="ot-all" bindtap="goOrders" data-status="">全部订单 ›</text>
    </view>
    <view class="order-grid">
      <view class="order-entry" bindtap="goOrders" data-status="1">
        <text class="oe-icon">💳</text>待付款
        <text wx:if="{{orderStat.unpaid>0}}" class="order-num">{{orderStat.unpaid}}</text>
      </view>
      <view class="order-entry" bindtap="goOrders" data-status="2">
        <text class="oe-icon">📦</text>待备货
        <text wx:if="{{orderStat.prepare>0}}" class="order-num">{{orderStat.prepare}}</text>
      </view>
      <view class="order-entry" bindtap="goOrders" data-status="3">
        <text class="oe-icon">🛵</text>配送中
        <text wx:if="{{orderStat.shipping>0}}" class="order-num">{{orderStat.shipping}}</text>
      </view>
      <view class="order-entry" bindtap="goOrders" data-status="5">
        <text class="oe-icon">↩️</text>退货/售后
        <text wx:if="{{orderStat.aftersale>0}}" class="order-num">{{orderStat.aftersale}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索与分类 -->
  <view class="search-row">
    <input class="search-input" placeholder="搜索好物" value="{{keyword}}" bindinput="onInput" bindconfirm="search" />
    <button class="search-btn" bindtap="search">搜索</button>
  </view>
  <scroll-view scroll-x class="cate-bar">
    <view class="cate {{categoryId===null?'on':''}}" bindtap="pickCate" data-id="">全部</view>
    <view class="cate {{categoryId===item.id?'on':''}}" wx:for="{{categories}}" wx:key="id" bindtap="pickCate" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <view class="section-title">
    <h2>同学都在买</h2>
    <text class="more">全部好物</text>
  </view>

  <!-- 两列商品 -->
  <view class="products">
    <view class="product" wx:for="{{goods}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="product-img">
        <image wx:if="{{item.cover}}" src="{{imgBase}}{{item.cover}}" mode="aspectFill" class="product-cover" />
        <text wx:else>🛍️</text>
      </view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-foot">
        <text class="price">¥{{item.price}}</text>
        <view class="add" catchtap="quickAdd" data-item="{{item}}">＋</view>
      </view>
    </view>
  </view>
  <view wx:if="{{goods.length===0}}" class="empty">暂无商品</view>
  </block>
</view>
