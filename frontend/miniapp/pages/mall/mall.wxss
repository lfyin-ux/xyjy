/* 购物车角标 */
.cart-btn {
  position: relative;
  overflow: visible;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: var(--pink);
  color: #fff;
  border-radius: 20rpx;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  padding: 0 6rpx;
  border: 3rpx solid #fff;
}

/* 顶部宣传卡 */
.mall-hero {
  margin: 0 32rpx 36rpx;
  height: 370rpx;
  border-radius: 56rpx;
  padding: 48rpx;
  background: linear-gradient(130deg, #ffdede, #ffeebc);
  position: relative;
  overflow: hidden;
}

.hero-small {
  font-size: 26rpx;
  color: #9a6a5a;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  margin: 8rpx 0 24rpx;
  line-height: 1.25;
}

.hero-br {
  display: block;
}

.hero-btn {
  border: 0;
  padding: 0 30rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 28rpx;
  background: var(--ink);
  color: #fff;
  font-size: 26rpx;
  display: inline-block;
  margin: 0;
}

.hero-emoji {
  position: absolute;
  right: 24rpx;
  bottom: -36rpx;
  font-size: 210rpx;
}

/* 我的订单入口 */
.order-panel {
  margin: 0 32rpx 36rpx;
  padding: 30rpx 28rpx;
  background: #fff;
  border-radius: 46rpx;
  box-shadow: 0 14rpx 44rpx rgba(34, 27, 78, 0.05);
}

.order-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.ot-name {
  font-size: 32rpx;
  font-weight: 700;
}

.ot-all {
  color: var(--muted);
  font-size: 24rpx;
}

.order-grid {
  display: flex;
}

.order-entry {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--ink);
  position: relative;
}

.oe-icon {
  display: block;
  font-size: 50rpx;
  margin-bottom: 12rpx;
}

.order-num {
  position: absolute;
  top: -6rpx;
  right: 26rpx;
  background: var(--pink);
  color: #fff;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  padding: 0 6rpx;
}

/* 搜索与分类 */
.search-row {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 30rpx;
  padding: 0 30rpx;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 28rpx;
}

.search-btn {
  background: var(--purple);
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 78rpx;
  margin: 0;
}

.cate-bar {
  white-space: nowrap;
  padding: 0 32rpx 10rpx;
}

.cate {
  display: inline-block;
  padding: 16rpx 30rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #615e70;
}

.cate.on {
  background: var(--purple);
  color: #fff;
}

/* 两列商品 */
.products {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 32rpx;
}

.product {
  background: #fff;
  border-radius: 36rpx;
  padding: 16rpx;
  overflow: hidden;
}

.product-img {
  height: 200rpx;
  border-radius: 34rpx;
  background: #efedfa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  overflow: hidden;
}

.product-cover {
  width: 100%;
  height: 100%;
}

.product-name {
  font-size: 28rpx;
  margin: 20rpx 6rpx 10rpx;
}

.product-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 6rpx 6rpx;
}

.add {
  border: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 14rpx;
  background: var(--purple);
  color: #fff;
  font-size: 32rpx;
  padding: 0;
  margin: 0;
}

/* 认证锁定提示 */
.gate {
  text-align: center;
  padding: 80rpx 40rpx;
}

.gate-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.gate-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.gate-desc {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 40rpx;
}
