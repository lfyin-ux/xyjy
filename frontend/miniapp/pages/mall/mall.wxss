.banner {
  margin: 0 32rpx 30rpx;
  border-radius: 52rpx;
  padding: 40rpx;
  background: #ffe7be;
  min-height: 220rpx;
  position: relative;
  overflow: hidden;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.banner-sub {
  color: #7a5a2d;
  font-size: 26rpx;
}

.banner-emoji {
  position: absolute;
  right: 28rpx;
  bottom: -20rpx;
  font-size: 150rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx 20rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 30rpx;
  padding: 22rpx 30rpx;
  font-size: 28rpx;
}

.search-btn {
  background: var(--purple);
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 78rpx;
  margin: 0;
}

.cate-bar {
  white-space: nowrap;
  padding: 0 32rpx 20rpx;
}

.cate {
  display: inline-block;
  padding: 16rpx 30rpx;
  margin-right: 16rpx;
  background: #fff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #615e70;
}

.cate.on {
  background: var(--purple);
  color: #fff;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

.goods-item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
}

.goods-item {
  margin-bottom: 16rpx;
}

.goods-pic {
  width: 100%;
  height: 320rpx;
  border-radius: 36rpx;
  background: #ede9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  overflow: hidden;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  margin: 14rpx 8rpx 8rpx;
}

.goods-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 8rpx;
}

.goods-sales {
  color: var(--muted);
  font-size: 22rpx;
}
