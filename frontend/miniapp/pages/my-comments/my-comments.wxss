.page {
  padding: 24rpx 32rpx;
}

.tab-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  background: #fff;
  border-radius: 28rpx;
  font-size: 28rpx;
  color: #615e70;
}

.tab.on {
  background: var(--purple);
  color: #fff;
  font-weight: 600;
}

.item {
  background: #fff;
  border-radius: 36rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.post-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.avatar-ph {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.author-name {
  font-size: 26rpx;
  color: var(--purple);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  font-size: 22rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.post-preview {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #f8f7fc;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.post-text {
  flex: 1;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.my-comment {
  padding-top: 4rpx;
}

.parent-line {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.parent-label {
  color: var(--purple);
}

.parent-text {
  color: #777;
}

.comment-line {
  font-size: 28rpx;
  line-height: 1.6;
}

.comment-label {
  color: var(--ink);
  font-weight: 600;
}

.comment-text {
  color: var(--ink);
}

.vis-tag {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--purple);
  background: #eeeaff;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
  padding: 120rpx 0;
}
