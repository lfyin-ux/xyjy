.chat-list {
  padding: 0 32rpx;
}

.chat-swipe {
  position: relative;
  overflow: hidden;
  border-radius: 44rpx;
  margin-bottom: 22rpx;
}

.chat-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  background: #fff;
  border-radius: 44rpx;
  padding: 28rpx;
  transition: transform 0.2s;
  position: relative;
  z-index: 1;
}

.chat-del {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  background: #ff2d55;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 0 44rpx 44rpx 0;
}

.chat-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 36rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  position: relative;
  overflow: visible;
  flex-shrink: 0;
}

.chat-avatar .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
}

.unread {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  background: #ff2d55;
  color: #fff;
  border: 4rpx solid #fff;
  border-radius: 28rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  padding: 0 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 45, 85, 0.4);
}

.chat-main {
  flex: 1;
  min-width: 0;
}

.chat-line {
  display: flex;
  justify-content: space-between;
}

.chat-name {
  font-weight: 700;
  font-size: 30rpx;
}

.chat-time {
  color: #aaa6b5;
  font-size: 24rpx;
}

.chat-last {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.status {
  font-size: 22rpx;
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
  background: #fff0f3;
  color: var(--pink);
  flex-shrink: 0;
}

.status.ok {
  background: #edebff;
  color: var(--purple);
}

/* 认证锁定提示 */
.gate {
  text-align: center;
  padding: 80rpx 40rpx;
}

.gate-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.gate-title {
  font-size: 38rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.gate-desc {
  color: var(--muted);
  font-size: 28rpx;
  line-height: 1.7;
  margin-bottom: 40rpx;
}
