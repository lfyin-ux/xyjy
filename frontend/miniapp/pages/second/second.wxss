.page {
  padding: 24rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 8rpx 20rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 30rpx;
  padding: 0 30rpx;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 28rpx;
}

.search-btn {
  background: var(--purple);
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  line-height: 78rpx;
  margin: 0;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
}

.goods-item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.goods-pic {
  width: 100%;
  height: 320rpx;
  border-radius: 36rpx;
  background: #ede9ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 90rpx;
  overflow: hidden;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  margin: 14rpx 8rpx 4rpx;
}

.goods-cond {
  color: var(--muted);
  font-size: 22rpx;
  margin: 0 8rpx 8rpx;
}

.goods-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 8rpx;
}

.status-tag {
  background: #eeeaff;
  color: var(--purple);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 40rpx;
  background: var(--purple);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(108, 92, 231, 0.4);
  padding: 0;
  line-height: 1;
}
