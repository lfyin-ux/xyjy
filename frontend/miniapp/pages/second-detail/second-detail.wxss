.page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.goods-cover,
.goods-swiper {
  width: 100%;
  height: 600rpx;
  background: #ede9ff;
}

.goods-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.card {
  background: #fff;
  border-radius: 40rpx;
  padding: 32rpx;
  margin: 24rpx;
}

.goods-name {
  font-size: 36rpx;
  font-weight: 700;
}

.goods-price {
  color: var(--pink);
  font-size: 44rpx;
  font-weight: 900;
  margin: 16rpx 0;
}

.goods-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: #f3f2f8;
  color: var(--muted);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.goods-desc {
  font-size: 28rpx;
  line-height: 1.7;
  color: #555;
  white-space: pre-wrap;
}

.contact-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 28rpx rgba(34, 27, 78, 0.08);
}

.contact-info {
  flex: 1;
  min-width: 0;
}

.contact-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
}

.contact-value {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contact-btn {
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 40rpx;
  background: var(--purple);
  color: #fff;
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  text-align: center;
}
