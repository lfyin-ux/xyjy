.page {
  padding: 32rpx;
}

.dual {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  border-radius: 36rpx;
  padding: 24rpx 8rpx;
  background: #fff;
  color: var(--muted);
  font-weight: 800;
  font-size: 26rpx;
}

.mode-btn.active {
  background: var(--purple);
  color: #fff;
}

.task {
  background: #fff;
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.task-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-title {
  font-size: 32rpx;
  font-weight: 700;
}

.task-route {
  color: var(--muted);
  font-size: 26rpx;
  margin: 16rpx 0 8rpx;
}

.task-time {
  color: var(--muted);
  font-size: 24rpx;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.task-sub {
  color: var(--muted);
  font-size: 24rpx;
}

.accept {
  border: 0;
  border-radius: 24rpx;
  padding: 0 30rpx;
  background: var(--purple);
  color: #fff;
  font-size: 26rpx;
  line-height: 68rpx;
  margin: 0;
}

.status-tag {
  background: #eeeaff;
  color: var(--purple);
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 40rpx;
  background: var(--purple);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(108, 92, 231, 0.4);
  padding: 0;
  line-height: 1;
}

.task-info {
  color: var(--purple);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.task-btns {
  display: flex;
  gap: 16rpx;
}

.cancel-btn {
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 0 24rpx;
  background: #fff;
  color: #615e70;
  font-size: 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
}

.task-contact {
  color: var(--purple);
  font-size: 24rpx;
  margin-top: 12rpx;
}

.taker-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--line);
}

.taker-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  overflow: hidden;
}

.taker-img {
  width: 100%;
  height: 100%;
}

.taker-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink);
}

.taker-arrow {
  color: #ccc;
  font-size: 36rpx;
}
