.page {
  padding: 32rpx;
}

.dual {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  border-radius: 36rpx;
  padding: 30rpx 8rpx;
  background: #fff;
  color: var(--muted);
  font-weight: 800;
  font-size: 30rpx;
}

.mode-btn.active {
  background: var(--purple);
  color: #fff;
}

.task {
  background: #fff;
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.task-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.task-title {
  font-size: 32rpx;
  font-weight: 700;
}

.task-route {
  color: var(--muted);
  font-size: 26rpx;
  margin: 16rpx 0 8rpx;
}

.task-time {
  color: var(--muted);
  font-size: 24rpx;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.task-sub {
  color: var(--muted);
  font-size: 24rpx;
}

.accept {
  border: 0;
  border-radius: 24rpx;
  padding: 0 30rpx;
  background: var(--purple);
  color: #fff;
  font-size: 26rpx;
  line-height: 68rpx;
  margin: 0;
}

.status-tag {
  background: #eeeaff;
  color: var(--purple);
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 40rpx;
  background: var(--purple);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 50rpx rgba(108, 92, 231, 0.4);
  padding: 0;
  line-height: 1;
}
