<view class="page">
  <swiper wx:if="{{imageList.length>0}}" class="goods-swiper" indicator-dots circular>
    <swiper-item wx:for="{{imageList}}" wx:key="*this">
      <image src="{{imgBase}}{{item}}" mode="aspectFill" class="cover-img" />
    </swiper-item>
  </swiper>
  <view wx:else class="goods-cover">
    <text>🛍️</text>
  </view>

  <view class="card">
    <view class="goods-name">{{goods.name}}</view>
    <view class="goods-price">¥ {{goods.price}}</view>
    <view class="goods-sales">库存 {{goods.stock}} · 已售 {{goods.sales}}</view>
  </view>

  <view wx:if="{{specList.length>0}}" class="card">
    <view class="card-title">选择规格</view>
    <view class="spec-list">
      <view class="spec {{spec===item?'on':''}}" wx:for="{{specList}}" wx:key="*this" bindtap="pickSpec" data-s="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">商品详情</view>
    <view class="goods-detail">{{goods.detail}}</view>
  </view>

  <!-- 收货地址 -->
  <view class="card addr-select" bindtap="chooseAddress">
    <block wx:if="{{selectedAddress}}">
      <view class="addr-info">
        <text class="addr-receiver">{{selectedAddress.receiver}} {{selectedAddress.phone}}</text>
        <view class="addr-text">{{selectedAddress.address}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="addr-empty">请选择收货地址</view>
    </block>
    <text class="addr-arrow">›</text>
  </view>

  <view class="buy-bar">
    <view class="qty">
      <text class="qty-btn" bindtap="minus">-</text>
      <text class="qty-num">{{quantity}}</text>
      <text class="qty-btn" bindtap="plus">+</text>
    </view>
    <view class="cart-btn" bindtap="addCart">加入购物车</view>
    <view class="buy-btn" bindtap="buyNow">立即购买</view>
  </view>
</view>
