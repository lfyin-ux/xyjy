.page {
  padding: 32rpx;
}

.album-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.album-item {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  aspect-ratio: 1;
}

.album-img {
  width: 100%;
  height: 100%;
}

.album-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 38rpx;
  font-size: 28rpx;
}

.album-audit {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  text-align: center;
  font-size: 20rpx;
  padding: 6rpx 0;
}

.album-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed #c9c5dd;
  border-radius: 24rpx;
  background: #fafafd;
  aspect-ratio: 1;
}

.add-icon {
  font-size: 56rpx;
  color: #c9c5dd;
}

.add-text {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.album-tip {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 30rpx;
}

/* 全屏预览遮罩 */
.preview-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.preview-img {
  width: 100%;
  height: 80vh;
}
