.page {
  padding: 32rpx;
  min-height: 100vh;
}

.login-header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.login-brand {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.login-brand i {
  color: var(--purple);
  font-style: normal;
}

.login-sub {
  color: var(--muted);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.user-list {
  margin-bottom: 36rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid transparent;
  transition: border-color 0.2s;
}

.user-card.selected {
  border-color: var(--purple);
  background: #f8f6ff;
}

.uc-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.uc-img {
  width: 100%;
  height: 100%;
}

.uc-main {
  flex: 1;
  min-width: 0;
}

.uc-name {
  font-size: 30rpx;
  font-weight: 700;
}

.uc-info {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 6rpx;
}

.uc-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--purple);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  border: 0;
  border-radius: 30rpx;
  background: var(--purple);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  margin: 0;
}

.login-btn[disabled] {
  opacity: 0.5;
  background: #b8b0e8 !important;
}

.dev-tip {
  text-align: center;
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 20rpx;
}

/* 生产模式微信登录 */
.wx-login {
  text-align: center;
  padding-top: 200rpx;
}

.login-slogan {
  color: var(--muted);
  font-size: 28rpx;
  margin: 16rpx 0 80rpx;
}

.wx-icon {
  font-size: 120rpx;
  margin-bottom: 60rpx;
}

.login-btn.wx {
  background: #07c160;
}

.wx-tip {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
}

.wx-agree {
  margin-top: 0;
  margin-bottom: 32rpx;
  text-align: left;
  padding: 0 20rpx;
}

.agree-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  margin-top: 4rpx;
}

.agree-check.on {
  background: var(--purple);
  border-color: var(--purple);
}

.agree-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--muted);
}

.agree-link {
  color: var(--purple);
}
