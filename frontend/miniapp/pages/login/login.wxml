<view class="page">
  <!-- 开发模式 显示用户列表选择登录 -->
  <block wx:if="{{mode==='dev'}}">
    <view class="login-header">
      <view class="login-brand">同行<i>时空</i></view>
      <view class="login-sub">开发模式 · 选择一个用户登录</view>
    </view>

    <view class="user-list">
      <view class="user-card {{currentId===item.id?'selected':''}}" wx:for="{{users}}" wx:key="id" bindtap="selectUser" data-item="{{item}}">
        <view class="uc-avatar">
          <image wx:if="{{item.avatar}}" src="{{imgBase}}{{item.avatar}}" mode="aspectFill" class="uc-img" />
          <text wx:else>🧑</text>
        </view>
        <view class="uc-main">
          <view class="uc-name">{{item.nickname}}</view>
          <view class="uc-info">{{item.school}} · {{item.college}}</view>
        </view>
        <view wx:if="{{currentId===item.id}}" class="uc-check">✓</view>
      </view>
    </view>

    <view class="agree-row" bindtap="toggleAgree">
      <view class="agree-check {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
      <view class="agree-text">
        我已阅读并同意
        <text class="agree-link" catchtap="openAgreement" data-type="user">《用户服务协议》</text>
        和
        <text class="agree-link" catchtap="openAgreement" data-type="privacy">《隐私政策》</text>
      </view>
    </view>
    <button class="login-btn" bindtap="devLogin" disabled="{{!currentId || !agreed}}">登录该用户</button>
    <button class="browse-btn" bindtap="goBrowse">暂不登录，先逛逛</button>
    <view class="dev-tip">切换不同用户可测试各功能模块</view>
  </block>

  <!-- 生产模式 微信一键授权登录 -->
  <block wx:else>
    <view class="wx-login">
      <view class="login-brand">同行<i>时空</i></view>
      <view class="login-slogan">连接校园，分享精彩生活</view>
      <view class="wx-icon">💬</view>
      <view class="agree-row wx-agree" bindtap="toggleAgree">
        <view class="agree-check {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
        <view class="agree-text">
          我已阅读并同意
          <text class="agree-link" catchtap="openAgreement" data-type="user">《用户服务协议》</text>
          和
          <text class="agree-link" catchtap="openAgreement" data-type="privacy">《隐私政策》</text>
        </view>
      </view>
      <button class="login-btn wx" bindtap="wxLogin" disabled="{{!agreed}}">微信一键登录</button>
      <button class="browse-btn" bindtap="goBrowse">暂不登录，先逛逛</button>
      <view class="wx-tip">授权后将使用微信账号登录，并依据隐私政策处理相关信息</view>
    </view>
  </block>
</view>
