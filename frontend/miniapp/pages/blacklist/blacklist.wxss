.page {
  padding: 32rpx;
}

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #eeeaff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 30rpx;
  font-weight: 700;
}

.user-sub {
  color: var(--muted);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.remove-btn {
  border: 2rpx solid var(--pink);
  color: var(--pink);
  background: #fff;
  border-radius: 26rpx;
  font-size: 26rpx;
  padding: 0 30rpx;
  line-height: 64rpx;
  margin: 0;
  flex-shrink: 0;
}
