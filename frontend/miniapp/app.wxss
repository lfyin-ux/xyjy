/* 全局样式 参照设计稿配色 */
page {
  --ink: #171527;
  --muted: #918da2;
  --purple: #6c5ce7;
  --pink: #ff557c;
  --lime: #d8ff7b;
  --paper: #f6f6fa;
  --line: #ebeaf1;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* 页面根容器 底部留出少量安全间距 内容可滚动不会被tabBar永久遮挡 */
.page {
  padding-bottom: env(safe-area-inset-bottom);
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

/* 重置微信 button 默认边距，解决按钮偏右/不居中 */
button {
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  font-size: inherit;
  box-sizing: border-box;
}

button::after {
  border: none;
}

.top {
  padding: 36rpx 36rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  font-size: 50rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.brand i {
  color: var(--purple);
  font-style: normal;
}

.icon-btn {
  border: 0;
  background: #fff;
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 44rpx rgba(34, 27, 78, 0.08);
  padding: 0;
  line-height: 1;
}

/* 顶部渐变卡片 */
.hero {
  margin: 8rpx 32rpx 32rpx;
  border-radius: 54rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #201a3b, #523c96);
  color: #fff;
}

.hero .small {
  color: #d8d3ee;
  font-size: 26rpx;
}

.hero h2 {
  margin: 14rpx 0 10rpx;
  font-size: 50rpx;
}

/* 主按钮 */
.primary {
  width: 100%;
  border: 0;
  border-radius: 34rpx;
  padding: 28rpx;
  background: var(--purple);
  color: #fff;
  font-weight: 800;
  font-size: 30rpx;
  margin: 0;
}

.secondary {
  width: 100%;
  border: 2rpx solid var(--purple);
  border-radius: 34rpx;
  padding: 26rpx;
  background: #fff;
  color: var(--purple);
  font-weight: 800;
  font-size: 30rpx;
  margin: 0;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 46rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 14rpx 44rpx rgba(34, 27, 78, 0.05);
}

/* 标签 */
.chip {
  display: inline-block;
  padding: 12rpx 20rpx;
  background: #eeeaff;
  color: var(--purple);
  border-radius: 40rpx;
  font-size: 24rpx;
  margin: 0 10rpx 10rpx 0;
}

/* 表单 */
.field {
  margin-bottom: 28rpx;
}

.field .label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}

.field input {
  width: 100%;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 0 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #fafafd;
  font-size: 28rpx;
}

.field textarea {
  width: 100%;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  height: 160rpx;
  background: #fafafd;
  font-size: 28rpx;
}

/* 分区标题 */
.section-title {
  padding: 8rpx 36rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.section-title h2 {
  margin: 0;
  font-size: 46rpx;
}

.section-title .more {
  color: var(--purple);
  font-size: 26rpx;
}

.price {
  color: var(--pink);
  font-weight: 900;
}

/* 空状态 */
.empty {
  text-align: center;
  color: var(--muted);
  padding: 80rpx 0;
  font-size: 28rpx;
}
